{
  "manifest_version": 3,
  "name": "Arena Live Helper",
  "version": "0.1.0",
  "description": "Gom các bước chuyển trận livestream trên YouTube Studio thành vài nút bấm cho từng bàn.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": ["https://studio.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Arena Live Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": [
        "shared/text.js",
        "content/selectors.js",
        "content/dom.js",
        "content/inspector.js",
        "content/flows.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
